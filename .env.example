VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
# Server-only Supabase credentials used by Vercel API routes and private
# application-document storage. Do not expose these with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_APP_URL=https://epa-mini-app.vercel.app

# Transactional email — easiest option: existing Gmail account + Google App Password.
# Enable two-step verification, generate a 16-digit App Password, then add these in Vercel.
GMAIL_USER=your-epa-email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_google_app_password
EMAIL_FROM=EPA Membership <your-epa-email@gmail.com>
# Use the exact public Vercel URL so email buttons and the EPA logo resolve correctly.
APP_URL=https://your-live-project.vercel.app

# Optional alternative: Resend with a verified domain.
# RESEND_API_KEY=re_your_resend_api_key

# Server-side administrator login. Do not prefix these values with VITE_, and
# set the same three secrets in the Vercel Project Settings → Environment Variables.
EPA_ADMIN_USERNAME=choose_an_admin_username
EPA_ADMIN_PASSWORD=use_a_long_unique_password
EPA_ADMIN_SESSION_SECRET=use_a_separate_long_random_secret
# Optional but recommended separate secret for signed member sessions. The
# existing admin session secret is used temporarily if this is not yet set.
EPA_MEMBER_SESSION_SECRET=use_another_long_random_secret
